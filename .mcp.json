{
  "mcpServers": {
    "tavily": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "tavily-mcp@latest"]
    },
    "paddleocr": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "paddleocr-mcp[local-cpu]", "paddleocr_mcp"],
      "env": {
        "PADDLEOCR_MCP_PIPELINE": "OCR",
        "PADDLEOCR_MCP_PPOCR_SOURCE": "local",
        "PADDLEOCR_MCP_DEVICE": "cpu",
        "PADDLEOCR_MCP_TIMEOUT": "120"
      }
    },
    "git": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "C:\\Users\\zhangsihai\\Desktop\\考研知识库系统"
      ],
      "env": {
        "GIT_PYTHON_GIT_EXECUTABLE": "D:\\Program Files\\Git\\cmd\\git.exe"
      }
    }
  }
}
